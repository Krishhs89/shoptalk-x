# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/

# Data (downloaded/generated, not committed)
data/raw/*
data/processed/*
data/chroma/
data/logs/
data/personalization/*.jsonl
data/verification/pairs.jsonl
!data/raw/.gitkeep
!data/processed/.gitkeep

# Notebooks
.ipynb_checkpoints/

# Models / experiment tracking
mlruns/
mlflow-data/
# Full fine-tuned embedding checkpoint (~440MB) -- too large for git; export to
# MLflow registry / HF Hub instead (see README). NOTE: keep this comment on its
# own line above the pattern, not inline after it -- git's .gitignore parser
# does not strip inline "# ..." comments, so `data/models/  # comment` was
# silently matching nothing and letting the whole directory get staged (same
# bug class already hit once before with the *.docx rule).
data/models/
*.bin
*.gguf

# data/eval/ (golden set), results/, and data/verification/mlp_head.pt ARE
# committed -- required submission deliverables (test dataset, evaluation
# results, the small trained verification head), not regenerable junk.

# Env / secrets
.env
*.pem

# Safety net -- this folder has picked up unrelated personal files (e.g. a
# credentials doc) during dev; never let *.docx get staged by accident.
*.docx

# OS
.DS_Store
